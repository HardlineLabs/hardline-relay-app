<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <queries><package android:name="com.geeksville.mesh" /><package android:name="com.atakmap.app.civ" /></queries>
    <application android:allowBackup="false" android:label="Hardline Relay" android:icon="@drawable/ic_hardline"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:supportsRtl="true" android:usesCleartextTraffic="false">
        <activity android:name=".SecureScanActivity" android:exported="false" android:screenOrientation="fullSensor" />
        <provider android:name=".ProfileProvider" android:authorities="com.hardlinelabs.relay.profiles" android:exported="true" android:grantUriPermissions="true" />
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
